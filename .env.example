# ============================================================
# VEXA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=VEXA
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ----------------------------
# API server and access control
# ----------------------------
# The API can write files and run tests: keep it on localhost.
API_HOST=127.0.0.1
API_PORT=8000
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret. When set, clients must send "Authorization: Bearer <token>"
# (the frontend reads it from VITE_VEXA_API_TOKEN in frontend/.env.local).
API_TOKEN=

# ----------------------------
# Run registry / experiments
# ----------------------------
# Empty DATABASE_URL = SQLite file at VEXA_DB_PATH.
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:password@host:5432/vexa
DATABASE_URL=
VEXA_DB_PATH=data/vexa.sqlite3

# ----------------------------
# Logging
# ----------------------------
LOG_LEVEL=INFO
LOG_JSON=false
# Export OpenTelemetry spans (optional), e.g. http://localhost:4318/v1/traces for Jaeger/Tempo
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ----------------------------
# Workspaces and sandbox
# ----------------------------
WORKSPACE_ROOT=workspaces
# Absolute directories where a workspace may use a custom output folder (comma-separated).
# Empty = custom output folders are disabled.
WORKSPACE_ALLOWED_OUTPUT_ROOTS=

# 'local' (subprocess, limited isolation) or 'docker' (throwaway container, no network).
SANDBOX_BACKEND=local
# docker CLI name or absolute path, e.g. /Applications/Docker.app/Contents/Resources/bin/docker
SANDBOX_DOCKER_BINARY=docker
# Build it with: docker build -t vexa-sandbox:latest -f docker/sandbox.Dockerfile docker
SANDBOX_DOCKER_IMAGE=vexa-sandbox:latest
SANDBOX_DOCKER_CPUS=1.0
TOOL_MAX_MEMORY_MB=1024
TOOL_MAX_FILE_WRITE_MB=64
TOOL_EXEC_TIMEOUT_SECONDS=120
TOOL_MAX_OUTPUT_BYTES=1048576
TOOL_MAX_FILE_BYTES=524288
TOOL_MAX_LIST_FILES=500
TOOL_MAX_SEARCH_RESULTS=200

# ============================================================
# Agents (all prefixed VEXA_)
# ============================================================
# LLM (real mode). Any LiteLLM model string.
# Provider keys may also be given by their own names (GROQ_API_KEY, OPENAI_API_KEY, ...); VEXA exports only
# those allowlisted names from this file. GET /agent-runs/provider-status shows what is configured (no values).
# Groq example (check which models your account can use: the Llama 3.x models are retired on some accounts):
#   VEXA_LLM_PROVIDER=groq
#   VEXA_LLM_MODEL=groq/openai/gpt-oss-120b
#   GROQ_API_KEY=gsk_...
VEXA_LLM_PROVIDER=openai
VEXA_LLM_MODEL=gpt-4o-mini
VEXA_LLM_API_KEY=
VEXA_LLM_TEMPERATURE=0.1
# USD per 1M tokens — only used to *estimate* cost; leave empty if unknown (cost is then reported as n/a).
VEXA_LLM_INPUT_COST_PER_1M=
VEXA_LLM_OUTPUT_COST_PER_1M=
# Optional fallback when the primary hits a daily quota.
VEXA_LLM_FALLBACK_PROVIDER=
VEXA_LLM_FALLBACK_MODEL=
VEXA_LLM_FALLBACK_API_KEY=

# Controls held constant across architectures
VEXA_AGENT_MAX_ITER=10
VEXA_DEBUG_MAX_ITER=3
VEXA_OUTPUT_VALIDATION_RETRIES=2
VEXA_MAX_TOOL_CALLS_PER_AGENT=25
VEXA_MAX_RUN_SECONDS=1800
# Hierarchical: how many times the Manager may send work back (re-plan / re-code / rework)
VEXA_MANAGER_REVISION_BUDGET=2
# Hierarchical MOCK mode only: category → strategy overrides (reproduce_first | baseline_then_plan | plan_first).
# Categories come from the run's task_category (benchmark task.json "category" in experiments).
VEXA_MANAGER_MOCK_POLICY=
# Rerun with an archived prompt version (16-hex); normally set per experiment by POST /experiments/{id}/rerun
VEXA_PROMPT_VERSION_PIN=
# G6 model-based injection classifier: auto (real mode + GROQ_API_KEY) | on | off. Signal only, never a boundary.
VEXA_INJECTION_CLASSIFIER=auto
VEXA_INJECTION_CLASSIFIER_MODEL=groq/meta-llama/llama-prompt-guard-2-86m
# baseline | react | few_shot | minimal_persona
VEXA_PROMPT_VARIANT=baseline

# Tools: 'mcp' (agents use tools through the vexa-workspace MCP server) or 'direct'
VEXA_TOOL_TRANSPORT=mcp
# Docs search MCP server (Tavily). Empty = search_docs disabled (reported on every run).
TAVILY_API_KEY=
VEXA_DOCS_SEARCH_ROLES=Planner,Coder,Debugger

# Verifier: 'adk_a2a' (Google ADK agent over A2A, default) or 'crewai' (in-process)
VEXA_VERIFIER_BACKEND=adk_a2a
# The backend starts the ADK A2A server itself on localhost (random token). Set false to use
# an external server at VEXA_A2A_VERIFIER_URL with VEXA_A2A_TOKEN.
VEXA_A2A_EMBEDDED=true
VEXA_A2A_EMBEDDED_PORT=8101
VEXA_A2A_VERIFIER_URL=http://127.0.0.1:8101
VEXA_A2A_TOKEN=
# Model for the ADK verifier service (LiteLLM string); defaults to VEXA_LLM_MODEL / VEXA_LLM_API_KEY.
VEXA_ADK_MODEL=
VEXA_ADK_API_KEY=

# Mock-mode UI demos: artificial delay per agent step (seconds)
VEXA_MOCK_STEP_DELAY_SECONDS=0

# CrewAI anonymous telemetry is disabled by VEXA; set to false to re-enable.
CREWAI_DISABLE_TELEMETRY=true

# Read a different settings file, or none ("" — the test suite does this so it never sees real keys)
# VEXA_ENV_FILE=.env
